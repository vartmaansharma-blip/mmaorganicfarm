NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Shopify checkout links. Product variant IDs must be the numeric variant IDs
# shown in Shopify Admin; GID-form IDs are also accepted.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_WEBHOOK_SECRET=your-orders-paid-webhook-secret
SHOPIFY_VARIANT_MILK=gid://shopify/ProductVariant/00000000000000
SHOPIFY_VARIANT_PANEER=gid://shopify/ProductVariant/00000000000000
SHOPIFY_VARIANT_GHEE=gid://shopify/ProductVariant/00000000000000

# Postponed catalog items. These are not required by the active checkout.
SHOPIFY_VARIANT_GLASS_BOTTLE=gid://shopify/ProductVariant/00000000000000
SHOPIFY_VARIANT_PAPAYA=gid://shopify/ProductVariant/00000000000000
SHOPIFY_VARIANT_SWEETS=gid://shopify/ProductVariant/00000000000000

# Server-only database access used after verified payment webhooks.
SUPABASE_SECRET_KEY=sb_secret_your_server_key
